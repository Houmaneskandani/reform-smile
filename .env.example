# ============================================
# Reform Dental — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git (it's in .gitignore)

# --- Anthropic Claude API (for the AI chat assistant) ---
# Get your key at: https://console.anthropic.com
# SECRET — server-only. Never add the NEXT_PUBLIC_ prefix (that would publish it in the
# website's JavaScript). Without it, the chat runs in demo mode with canned answers.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Web3Forms (for form email submissions) ---
# Get your key at: https://web3forms.com (free, enter Dr. Ava's email)
# Public by design (Web3Forms keys only allow sending to that inbox).
# REQUIRED in production: without it, the forms tell patients to call instead.
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_key_here

# --- Visitor statistics (the site's own, anonymous; see CLAUDE.md → "Visitor statistics") ---
# SECRET — server-only. Set automatically when a Neon Postgres database is added to the Vercel
# project (Vercel → Storage / Marketplace → Neon → connect to project "ava"). Use the website's own
# database, never Marketing Ava's. Without it, /api/track stores nothing.
DATABASE_URL=
# Local testing only: extra hosts whose visits are counted besides the real domain,
# e.g. ANALYTICS_TEST_HOSTS=127.0.0.1:3402 (comma-separated). Leave empty on Vercel.
ANALYTICS_TEST_HOSTS=

# --- Google Analytics ---
# Get tracking ID at: https://analytics.google.com
# Once the website editor is live in production, leave this unset in Vercel until the editor
# has moved to admin.<domain> (ADMIN_HOST below): gtag.js would run on the editor's origin.
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# --- Google Tag Manager (manages all tracking scripts) ---
# Get container ID at: https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Microsoft Clarity (free heatmaps + session recordings) ---
# Get project ID at: https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# --- Facebook/Meta Pixel (for ad retargeting) ---
# Get pixel ID at: https://business.facebook.com/events_manager
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Website editor (Keystatic, at /keystatic) — see "Admin panel" in CLAUDE.md ---
# Keystatic Cloud project as "team/project" (public ID, not a secret). Set it in Vercel
# Production to turn on the editor there; while it is unset, /keystatic is a 404 in
# production. Fixed at build time, so redeploy after changing it.
# Leave it EMPTY in .env.local: local editing (`npm run dev:admin`) needs nothing, and a value
# here would switch the local editor to Keystatic Cloud.
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=
# Optional, Vercel Production only, once the domain works: move the editor to its own
# subdomain, e.g. admin.reformdentalimplantcenter.com (see next.config.ts). Not a secret.
# Leave unset until that subdomain is added to Vercel and DNS. Once the editor is live in
# production, set this before turning on Google Analytics, GTM, Clarity or the Meta Pixel.
# (The local editor needs no variable: it runs under `npm run dev:admin` only.)
ADMIN_HOST=

# --- Twilio (future — email + SMS) ---
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SENDGRID_API_KEY=your_sendgrid_key
